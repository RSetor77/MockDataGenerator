<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:MockDataGenerator.Models"
        xmlns:viewmodels="using:MockDataGenerator.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MockDataGenerator.SelectWindow"
        Title="SelectWindow"
        x:DataType="viewmodels:SelectWindowViewModel">
    <Grid RowDefinitions="*, Auto">
		<ListBox ItemsSource="{Binding ValueTypes}"
                 SelectedItem="{Binding SelectedValueType}"
                 SelectionMode="Single">
			<ListBox.ItemTemplate>
				<DataTemplate DataType="models:OutputValueType">
					<TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button HorizontalAlignment="Right"
                Command="{Binding SelectAndCloseCommand}"
                Content="Выбрать"
                Grid.Row="1"/>
    </Grid>
</Window>
