<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
        xmlns:models="using:MockDataGenerator.Models"
        xmlns:viewmodels="using:MockDataGenerator.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="350"
        x:Class="MockDataGenerator.SelectWindow"
        Title="Выберите тип..." Width="400" Height="350"
        x:DataType="viewmodels:SelectWindowViewModel">
    <Grid>
		<ListBox ItemsSource="{Binding ValueTypes}"
                 SelectedItem="{Binding SelectedValueType}"
                 SelectionMode="Single">
			<ListBox.ItemTemplate>
				<DataTemplate DataType="models:OutputValueType">
					<TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <Interaction.Behaviors>
				<EventTriggerBehavior EventName="DoubleTapped">
					<InvokeCommandAction Command="{Binding SelectAndCloseCommand}"
                                         CommandParameter="{Binding $parent[Window]}"/>
                </EventTriggerBehavior>
                <KeyTrigger Key="Enter">
					<InvokeCommandAction Command="{Binding SelectAndCloseCommand}"
                                         CommandParameter="{Binding $parent[Window]}"/>
                </KeyTrigger>
            </Interaction.Behaviors>
        </ListBox>
        <!--Button HorizontalAlignment="Right"
                Command="{Binding SelectAndCloseCommand}"
                CommandParameter="{Binding $parent[Window]}"
                Content="Выбрать"
                Grid.Row="1"/-->
    </Grid>
</Window>
