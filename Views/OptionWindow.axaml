<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:MockDataGenerator"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:MockDataGenerator.Models"
        xmlns:viewmodels="using:MockDataGenerator.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="350"
        x:Class="MockDataGenerator.OptionWindow"
        Title="Настройки поля" x:DataType="viewmodels:OptionWindowViewModel">
  <Grid RowDefinitions="Auto, *">

      <Grid ColumnDefinitions="*, *" RowDefinitions="*, *" RowSpacing="5">
		  <CheckBox Content="Первичный ключ?" IsChecked="{Binding EditField.IsPK}"/>
          <CheckBox Grid.Column="1" Content="Не пустое?"
                    IsChecked="{Binding EditField.IsNotNull}"/>
          <Grid Grid.Row="1" Grid.ColumnSpan="2"
                ColumnDefinitions="Auto, *"
                ColumnSpacing="5">
              <TextBlock Text="Проверка:" VerticalAlignment="Center"/> 
              <TextBox Grid.Column="1" Text="{Binding EditField.Check}"/>
          </Grid>
      </Grid>

      <Grid RowDefinitions="Auto, *" Grid.Row="1">
		  <TextBlock Text="{Binding EditField.OutputValueType.DisplayName}"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Parameters}">
              <ListBox.ItemTemplate>
				  <DataTemplate x:DataType="models:OptionItem">
					  <Grid ColumnDefinitions="Auto, *">
						  <TextBlock Text="{Binding Key}"/>
                          <TextBox Text="{Binding Value}"/>
                      </Grid>
                  </DataTemplate>
              </ListBox.ItemTemplate>
          </ListBox>
      </Grid>
	  
  </Grid>
</Window>
