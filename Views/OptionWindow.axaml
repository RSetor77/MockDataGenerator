<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:MockDataGenerator"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:MockDataGenerator.Models"
        xmlns:viewmodels="using:MockDataGenerator.ViewModels"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="100"
        Width="300" Height="100"
        x:Class="MockDataGenerator.OptionWindow"
        Title="Настройки поля" x:DataType="viewmodels:OptionWindowViewModel">

    <Grid RowDefinitions="*, Auto">
        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="5"
              VerticalAlignment="Center">
		    <CheckBox Content="Первичный ключ?" IsChecked="{Binding EditField.IsPK}"/>
            <CheckBox Grid.Column="1" Content="Не пустое?" HorizontalAlignment="Right"
                    IsChecked="{Binding EditField.IsNotNull}"/>
            <Grid Grid.Row="1" Grid.ColumnSpan="2"
                ColumnDefinitions="Auto, *"
                ColumnSpacing="5">
                <TextBlock Text="Проверка:" VerticalAlignment="Center"/> 
                <TextBox Grid.Column="1" Text="{Binding EditField.Check}"/>
            </Grid>

            
        </Grid>
        <Button Grid.Row="2" Content="Применить"
                HorizontalAlignment="Right"
                Command="{Binding SelectAndCloseCommand}"
                CommandParameter="{Binding $parent[Window]}"/>
    </Grid>
        
</Window>
