<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MockDataGenerator.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="100"
             x:Class="MockDataGenerator.Controls.SQLFileSettings"
             x:DataType="vm:MainWindowViewModel">
  <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto" ColumnSpacing="5">
	  <StackPanel Orientation="Horizontal">
		  <TextBlock VerticalAlignment="Center" Text="СУБД: "/>
          <ComboBox MinWidth="100"
                    ItemsSource="{Binding DBMSRules}"
                    SelectedItem="{Binding SelectedDBMSRules}"/>
      </StackPanel>
      <DockPanel Grid.Column="1">
		  <TextBlock VerticalAlignment="Center" Text="Имя таблицы: "/>
          <TextBox Watermark="Введите имя таблицы..."
                   Text="{Binding TableName}"/>
      </DockPanel>
      <CheckBox Grid.Column="2" Content="Создать таблицу?"
                IsChecked="{Binding CreateTable}"/>
  </Grid>
</UserControl>
